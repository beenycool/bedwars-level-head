# Copy this file to .env and fill in the required value before starting the backend.
# Lines beginning with # are comments and are ignored.

# Required -----------------------------------------------------------------
# Hypixel API key owned by you. See https://developer.hypixel.net/
HYPIXEL_API_KEY=YOUR_HYPIXEL_API_KEY_PLACEHOLDER

# Optional but recommended ------------------------------------------------
# PostgreSQL cache (one table: player_stats_cache). When unset, the backend runs
# from its in-process cache only and still serves data.
#CACHE_DB_URL=postgresql://user:password@localhost:5432/levelhead_cache
# Set to true to skip TLS certificate validation for the cache database.
#DB_TRUST_SERVER_CERTIFICATE=false
#CACHE_DB_POOL_MAX=10

# Enables POST /api/admin/cache/purge with a Bearer token. Unset = endpoint off.
#ADMIN_API_KEYS=some-long-random-token

# Networking ---------------------------------------------------------------
#PORT=3000
#HOST=0.0.0.0
# Comma-separated CIDRs for trusted reverse proxies. When unset, production
# trusts exactly one proxy hop (Render/Cloudflare) and development trusts none.
#TRUST_PROXY_CIDRS=127.0.0.1/32,::1/128

# Rate limiting ------------------------------------------------------------
# Public budget per IP, in identifiers per minute. One batch of 100 players
# costs 100. Sized for a full BedWars hub; the bucket refills continuously.
#PUBLIC_RATE_LIMIT_MAX=600

# Hypixel upstream ---------------------------------------------------------
#HYPIXEL_API_BASE_URL=https://api.hypixel.net
#HYPIXEL_TIMEOUT_MS=5000
#HYPIXEL_RETRY_DELAY_MIN_MS=50
#HYPIXEL_RETRY_DELAY_MAX_MS=150
#CB_FAILURE_THRESHOLD=5
#CB_RESET_TIMEOUT_MS=30000

# Cache --------------------------------------------------------------------
# SQL retention for cached player rows (minimum 1 hour, default 24 hours).
#PLAYER_CACHE_DB_TTL_MS=86400000

# Logging ------------------------------------------------------------------
# Log verbosity: trace | debug | info | warn | error | fatal (default info).
#LOG_LEVEL=info
# Set to 1 with NODE_ENV=development for human-readable logs.
#LOG_PRETTY=1

# Local docker-compose only -------------------------------------------------
#POSTGRES_DB=levelhead_cache
#POSTGRES_USER=levelhead
#POSTGRES_PASSWORD=levelhead
