{
  "name": "levelhead-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --external:pg-native --loader:.html=text",
    "bundle": "npm run build",
    "start": "node dist/index.js",
    "dev": "LOG_PRETTY=1 NODE_ENV=development ts-node-dev --respawn src/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "cacheable-lookup": "^6.0.0",
    "compression": "^1.8.2",
    "dotenv": "^16.5.0",
    "express": "^4.22.3",
    "helmet": "^8.1.0",
    "ipaddr.js": "^2.3.0",
    "kysely": "^0.28.17",
    "lru-cache": "^11.2.4",
    "p-limit": "^3.1.0",
    "pg": "^8.13.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.30",
    "@types/pg": "^8.11.10",
    "@types/pino-http": "^5.8.4",
    "esbuild": "^0.28.1",
    "pino-pretty": "^13.1.3",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
